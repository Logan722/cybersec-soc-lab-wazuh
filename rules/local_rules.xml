<!--
================================================================================
  Wazuh Custom Detection Rules — local_rules.xml
  Project 1 — AI-Integrated SOC Lab
  Author: Daniel Oni
  Wazuh version: 4.14.x

  Phase 3 — 12 detections mapped to MITRE ATT&CK (rule IDs 100001-100012)
    Tactics covered: Execution, Persistence, Privilege Escalation,
    Defense Evasion, Credential Access, Discovery, Command and Control.

  Phase 4 — 6 AI/agent detections (rule IDs 100013-100018)
    Shadow AI, LLM data exfiltration, MCP/agent activity.
    Mapped to MITRE ATLAS + OWASP Agentic Top 10 (see per-rule comments).

  PARENT RULE IDs (<if_sid>) — VERIFY THESE AGAINST YOUR OWN INSTALL.
  Sysmon child-rule IDs can shift between ruleset versions. To confirm one:
  trigger the event on win-ep1, open it in Discover, and read its rule.id.
    61603  Sysmon EID 1   ProcessCreate
    61605  Sysmon EID 3   NetworkConnect
    61650  Sysmon EID 22  DnsQuery         (confirmed - used by rule 100015)
    61612  Sysmon EID 10  ProcessAccess
    61615  Sysmon EID 13  RegistryValueSet

  Conventions:
    - Custom rule IDs must be 100000-120000.
    - type="pcre2"  = regex match;  no type = exact substring match.
    - Multiple <field> entries are ANDed (every field must match).
    - Levels: 8 notable, 10-11 investigate, 12-13 high.
================================================================================
-->

<group name="local,custom,attack,">

  <!-- 100001 | T1059.001 PowerShell — Execution
       Encoded command line (-enc / -e / -encodedcommand). The image guard keeps
       this scoped to powershell.exe / powershell_ise.exe so it does not fire on
       unrelated processes that happen to carry an "-e" argument. -->
  <rule id="100001" level="10">
    <if_sid>61603</if_sid>
    <field name="win.eventdata.image" type="pcre2">(?i)\\powershell(_ise)?\.exe$</field>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)\s-(e|en|enc|enco|encod|encode|encoded|encodedcommand)\s</field>
    <description>PowerShell with encoded command line - possible obfuscation</description>
    <mitre><id>T1059.001</id></mitre>
    <group>powershell,execution,obfuscation,</group>
  </rule>

  <!-- 100002 | T1059.003 Windows Command Shell — Execution
       Office application spawning a shell/scripting host is a classic macro /
       phishing execution chain. Parent = Office app, child = shell. -->
  <rule id="100002" level="12">
    <if_sid>61603</if_sid>
    <field name="win.eventdata.image" type="pcre2">(?i)\\(cmd|powershell|wscript|cscript)\.exe$</field>
    <field name="win.eventdata.parentImage" type="pcre2">(?i)\\(winword|excel|powerpnt|outlook|msaccess)\.exe$</field>
    <description>Suspicious shell spawned by Microsoft Office application</description>
    <mitre><id>T1059.003</id></mitre>
    <group>office,execution,living_off_the_land,</group>
  </rule>

  <!-- 100003 | T1547.001 Registry Run Keys — Persistence
       Write to a CurrentVersion Run / RunOnce / RunServices key. targetObject is
       the Sysmon EID 13 registry path. -->
  <rule id="100003" level="10">
    <if_sid>61615</if_sid>
    <field name="win.eventdata.targetObject" type="pcre2">(?i)\\Software\\Microsoft\\Windows\\CurrentVersion\\(Run|RunOnce|RunServices)</field>
    <description>Persistence: Registry Run Key modified</description>
    <mitre><id>T1547.001</id></mitre>
    <group>persistence,registry,</group>
  </rule>

  <!-- 100004 | T1053.005 Scheduled Task — Persistence
       schtasks.exe /create. Scoped to the schtasks image so a mention of
       "/create" elsewhere does not trip it. -->
  <rule id="100004" level="10">
    <if_sid>61603</if_sid>
    <field name="win.eventdata.image" type="pcre2">(?i)\\schtasks\.exe$</field>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)\s/create\s</field>
    <description>Scheduled task created via schtasks.exe - possible persistence</description>
    <mitre><id>T1053.005</id></mitre>
    <group>persistence,scheduled_task,</group>
  </rule>

  <!-- 100005 | T1543.003 Windows Service — Persistence
       sc.exe create|config. Attackers install services for persistence and
       for running payloads as SYSTEM. -->
  <rule id="100005" level="10">
    <if_sid>61603</if_sid>
    <field name="win.eventdata.image" type="pcre2">(?i)\\sc\.exe$</field>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)\s(create|config)\s</field>
    <description>Windows service created or modified via sc.exe</description>
    <mitre><id>T1543.003</id></mitre>
    <group>persistence,service,</group>
  </rule>

  <!-- 100006 | T1548.002 Bypass UAC — Privilege Escalation
       fodhelper.exe reads HKCU ...\ms-settings\Shell\Open\command; writing that
       key hijacks a high-integrity auto-elevate. Registry write = EID 13. -->
  <rule id="100006" level="12">
    <if_sid>61615</if_sid>
    <field name="win.eventdata.targetObject" type="pcre2">(?i)\\Software\\Classes\\ms-settings\\Shell\\Open\\command</field>
    <description>UAC bypass technique: fodhelper.exe registry hijack</description>
    <mitre><id>T1548.002</id></mitre>
    <group>privilege_escalation,uac_bypass,</group>
  </rule>

  <!-- 100007 | T1218.011 Rundll32 — Defense Evasion
       Known LOLBin abuse patterns: inline javascript:, comsvcs MiniDump (LSASS
       dump), url.dll OpenURL, and Control_RunDLL loading from a drive path. -->
  <rule id="100007" level="10">
    <if_sid>61603</if_sid>
    <field name="win.eventdata.image" type="pcre2">(?i)\\rundll32\.exe$</field>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)(javascript:|comsvcs\.dll.*MiniDump|url\.dll.*OpenURL|shell32\.dll.*Control_RunDLL\s+[a-z]:)</field>
    <description>rundll32 invoked with suspicious arguments - LOLBin abuse</description>
    <mitre><id>T1218.011</id></mitre>
    <group>defense_evasion,lolbin,</group>
  </rule>

  <!-- 100008 | T1112 Modify Registry — Defense Evasion
       Policy keys that switch off Defender (DisableAntiSpyware / DisableAntiVirus
       / DisableRealtimeMonitoring). \s? tolerates the "Windows Defender" space. -->
  <rule id="100008" level="12">
    <if_sid>61615</if_sid>
    <field name="win.eventdata.targetObject" type="pcre2">(?i)\\Policies\\Microsoft\\Windows\s?Defender\\(DisableAntiSpyware|DisableAntiVirus|DisableRealtimeMonitoring)</field>
    <description>Registry modification to disable Windows Defender</description>
    <mitre><id>T1112</id></mitre>
    <group>defense_evasion,impair_defenses,</group>
  </rule>

  <!-- 100009 | T1027 Obfuscated Files or Information — Defense Evasion
       INTENTIONALLY BROAD: matches any 60+ char Base64-like blob on a command
       line. Kept as a teaching example of a noisy rule - contrast its false
       positive rate with the narrow rule 100001 in the writeup. Level kept low. -->
  <rule id="100009" level="8">
    <if_sid>61603</if_sid>
    <field name="win.eventdata.commandLine" type="pcre2">([A-Za-z0-9+/]{60,}={0,2})</field>
    <description>Command line contains long Base64-like string - possible obfuscation</description>
    <mitre><id>T1027</id></mitre>
    <group>defense_evasion,obfuscation,</group>
  </rule>

  <!-- 100010 | T1003.001 LSASS Memory — Credential Access
       ProcessAccess (EID 10) where the target is lsass.exe and grantedAccess is
       a mask commonly used by credential dumpers (Mimikatz / comsvcs). -->
  <rule id="100010" level="13">
    <if_sid>61612</if_sid>
    <field name="win.eventdata.targetImage" type="pcre2">(?i)\\lsass\.exe$</field>
    <field name="win.eventdata.grantedAccess" type="pcre2">(?i)0x1010|0x1410|0x143A|0x1FFFFF</field>
    <description>Suspicious process accessed LSASS memory - credential dumping signal</description>
    <mitre><id>T1003.001</id></mitre>
    <group>credential_access,lsass,</group>
  </rule>

  <!-- 100011 | T1018 Remote System Discovery — Discovery
       net.exe / net1.exe enumeration: net view, net group "Domain Admins",
       net user /domain. Optional quotes around "domain admins". -->
  <rule id="100011" level="8">
    <if_sid>61603</if_sid>
    <field name="win.eventdata.image" type="pcre2">(?i)\\net1?\.exe$</field>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)\s(view|group\s+"?domain\s+admins"?|user\s+/domain)</field>
    <description>Remote system / domain discovery via net.exe</description>
    <mitre><id>T1018</id></mitre>
    <group>discovery,</group>
  </rule>

  <!-- 100012 | T1071.001 Web Protocols — Command and Control
       NetworkConnect (EID 3) to a web port from a scripting / LOLBin binary that
       has no business making outbound web calls = possible C2 or download. -->
  <rule id="100012" level="10">
    <if_sid>61605</if_sid>
    <field name="win.eventdata.destinationPort" type="pcre2">^(80|443|8080|8443)$</field>
    <field name="win.eventdata.image" type="pcre2">(?i)\\(powershell|cmd|wscript|cscript|mshta|rundll32|regsvr32|certutil|bitsadmin)\.exe$</field>
    <description>Suspicious process making outbound HTTP/HTTPS connection - possible C2</description>
    <mitre><id>T1071.001</id></mitre>
    <group>command_and_control,</group>
  </rule>


  <!-- ========================================================================
       PHASE 4 — AI / AGENT THREAT DETECTIONS (rule IDs 100013-100018)
       ATLAS = MITRE ATLAS (atlas.mitre.org); ASI = OWASP Top 10 for Agentic Apps.
       Wazuh's <mitre><id> accepts standard ATT&CK IDs only, so ATLAS / ASI
       references live in <group> tags and in the comment above each rule.
       Network parent is 61605 (EID 3); DNS parent is 61650 (EID 22) - both
       confirmed against this install's ruleset.
       ===================================================================== -->

  <!-- 100013 | ATLAS AML.T0024 Exfiltration via AI Inference API | OWASP LLM02
       Scripting / LOLBin process making an outbound web connection - possible
       data exfil to an LLM API. Strongest paired with 100015 (DNS to AI domain). -->
  <rule id="100013" level="10">
    <if_sid>61605</if_sid>
    <field name="win.eventdata.destinationPort" type="pcre2">^(80|443)$</field>
    <field name="win.eventdata.image" type="pcre2">(?i)\\(powershell|pwsh|cmd|wscript|cscript|mshta|rundll32|regsvr32|certutil|bitsadmin|curl|python|node)\.exe$</field>
    <description>Scripting process made outbound web connection - possible data exfiltration to LLM inference API</description>
    <mitre><id>T1567</id></mitre>
    <group>ai_security,exfiltration,atlas_aml_t0024,owasp_llm02,</group>
  </rule>

  <!-- 100014 | ATLAS AML.T0012 Shadow AI - local LLM runtime executed.
       Level 8: a governance signal for an analyst, not a wake-someone-up alert. -->
  <rule id="100014" level="8">
    <if_sid>61603</if_sid>
    <field name="win.eventdata.image" type="pcre2">(?i)\\(ollama|ollama app|lm ?studio|jan|gpt4all|llamacpp|koboldcpp)\.exe$</field>
    <description>Local LLM runtime executed on managed endpoint - shadow AI</description>
    <mitre><id>T1059</id></mitre>
    <group>ai_security,shadow_ai,atlas_aml_t0012,</group>
  </rule>

  <!-- 100015 | ATLAS AML.T0012 AI usage visibility - endpoint resolved an LLM
       provider domain. Level 4: informational, builds an AI-usage picture.
       if_sid 61650 = Sysmon EID 22 (DnsQuery), confirmed on this install. -->
  <rule id="100015" level="4">
    <if_sid>61650</if_sid>
    <field name="win.eventdata.queryName" type="pcre2">(?i)(api\.openai\.com|api\.anthropic\.com|generativelanguage\.googleapis\.com|api\.cohere\.ai|api\.mistral\.ai|api\.groq\.com|.*\.openai\.azure\.com|bedrock.*\.amazonaws\.com|api\.together\.xyz|openrouter\.ai)</field>
    <description>Endpoint resolved LLM API provider domain - AI service usage visibility</description>
    <mitre><id>T1071.004</id></mitre>
    <group>ai_security,ai_governance,shadow_ai,atlas_aml_t0012,</group>
  </rule>

  <!-- 100016 | Shadow AI governance - AI CLI tool executed. Complements 100014. -->
  <rule id="100016" level="6">
    <if_sid>61603</if_sid>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)(ollama\s+(run|pull|serve)|\bllm\s+(-|--|"|')|aichat\s+|\bchatgpt-cli\b|\banthropic\s+messages\b)</field>
    <description>AI CLI tool executed on endpoint - shadow AI usage</description>
    <mitre><id>T1059</id></mitre>
    <group>ai_security,shadow_ai,</group>
  </rule>

  <!-- 100017 | ATLAS AML.T0012 - connection to a local LLM API port.
       11434 = Ollama, 1234 = LM Studio. 8080 omitted here - too noisy in-lab. -->
  <rule id="100017" level="9">
    <if_sid>61605</if_sid>
    <field name="win.eventdata.destinationPort" type="pcre2">^(11434|1234)$</field>
    <field name="win.eventdata.image" type="pcre2">(?i)\\(python|node|curl|powershell|pwsh)\.exe$</field>
    <description>Process connected to local LLM API port - local model in use, check if exposed</description>
    <mitre><id>T1071</id></mitre>
    <group>ai_security,shadow_ai,atlas_aml_t0012,</group>
  </rule>

  <!-- 100018 | OWASP ASI02 Tool Misuse, ASI04 Agentic Supply Chain | ATLAS AML.T0110
       MCP server / AI-agent tool process. Standout rule - few write MCP detections.
       MCP servers are privileged third-party integrations; poisoned tool metadata
       is a documented attack pattern. -->
  <rule id="100018" level="8">
    <if_sid>61603</if_sid>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)(mcp-server|@modelcontextprotocol|npx\s+.*mcp|uvx\s+.*mcp|mcp\.json|claude_desktop_config\.json)</field>
    <description>MCP server or AI agent tool process detected - verify against approved agent inventory</description>
    <mitre><id>T1059</id></mitre>
    <group>ai_security,agentic_ai,mcp,owasp_asi02,owasp_asi04,atlas_aml_t0110,</group>
  </rule>

</group>
